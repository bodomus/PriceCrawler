<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MPC-99: the project's own in-process mediator (CQRS requests, handlers, pipeline behaviors).
    It has no dependencies on the rest of the solution so any layer can reference it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PriceCrawler.Mediator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PriceCrawler.Mediator.Tests" />
  </ItemGroup>
</Project>
