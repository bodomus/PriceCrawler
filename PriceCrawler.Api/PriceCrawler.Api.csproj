<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    MPC-99: Web API of the new site (React frontend, MPC-100). Minimal APIs on top of the
    application layer: endpoints only translate HTTP to mediator requests and back.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PriceCrawler.Api</RootNamespace>
    <UserSecretsId>pricecrawler-api-6f1c2d3e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.20.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PriceCrawler.Application\PriceCrawler.Application.csproj" />
    <ProjectReference Include="..\PriceCrawler.Infrastructure\PriceCrawler.Infrastructure.csproj" />
    <ProjectReference Include="..\PriceCrawler.Mediator\PriceCrawler.Mediator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PriceCrawler.Api.Tests" />
  </ItemGroup>
</Project>
